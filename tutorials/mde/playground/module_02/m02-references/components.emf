@namespace(uri="components", prefix="components")
package components;

class Architecture {
  attr String[1] name;
  val Component[*] components;
  val Connector[*] connectors;
}

class Component {
  attr String[1] name;
  val Port[*] ports;
}

abstract class Port {
  attr String[1] name;
}
class InPort extends Port {}
class OutPort extends Port {}

class Connector {
  ref OutPort source;
  ref InPort target;
}
