?nsuri: components
architecture:
- name: Thermostat
- component:
  - name: Sensor
  - outPort: {name: reading, type: ANALOG}
- component:
  - name: Filter
  - inPort: {name: raw, type: ANALOG}
  - outPort: {name: smoothed, type: ANALOG}
- component:
  - name: Display
  - inPort: {name: value, type: ANALOG}
- connector: {source: Thermostat.Sensor.reading, target: Thermostat.Filter.raw}
- connector: {source: Thermostat.Filter.smoothed, target: Thermostat.Display.value}
