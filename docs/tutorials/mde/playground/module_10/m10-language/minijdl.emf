@namespace(uri="minijdl", prefix="minijdl")
package minijdl;
enum FieldType { STRING; INTEGER; BOOLEAN; }
class Application {
  attr String[1] name;
  val Entity[*] entities;
}
class Entity {
  attr String[1] name;
  val Field[*] fields;
  val Relation[*] relations;
}
class Field {
  attr String[1] name;
  attr FieldType type;
}
class Relation {
  attr String[1] name;
  ref Entity target;
}
