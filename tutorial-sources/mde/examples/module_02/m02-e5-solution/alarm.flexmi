<?nsuri components?>
<architecture name="Thermostat">
  <component name="Sensor">
    <outPort name="reading" type="ANALOG"/>
  </component>
  <component name="Controller">
    <inPort name="raw" type="ANALOG"/>
    <outPort name="command" type="DIGITAL"/>
  </component>
  <connector source="Thermostat.Sensor.reading" target="Thermostat.Controller.raw"/>
</architecture>
