@namespace(uri="relational", prefix="relational")
package relational;
class Schema {
  attr String name;
  val Table[*] tables;
}
class Table {
  attr String name;
  val Column[*] columns;
  val ForeignKey[*] foreignKeys;
}
class Column {
  attr String name;
  attr String sqlType;
}
class ForeignKey {
  attr String name;
  attr String column;
  ref Table target;
}
