context Entity {
  constraint UniqueEntityName {
    check: Entity.all.select(e | e.name = self.name).size() = 1
    message: "Duplicate entity: " + self.name
  }
}
context Field {
  constraint UniqueFieldName {
    check: self.eContainer().fields.select(f | f.name = self.name).size() = 1
    message: "Duplicate field: " + self.eContainer().name + "." + self.name
  }
}
context Relation {
  constraint HasTarget {
    check: not self.target.isUndefined()
    message: "Missing relation target: " + self.name
  }
}
