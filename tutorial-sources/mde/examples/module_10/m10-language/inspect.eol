var app = Application.all.first();
("Application: " + app.name).println();
for (e in app.entities) {
  var fieldNoun = "fields";
  if (e.fields.size() = 1) { fieldNoun = "field"; }
  var relationNoun = "relations";
  if (e.relations.size() = 1) { relationNoun = "relation"; }
  (e.name + ": " + e.fields.size() + " " + fieldNoun + ", " + e.relations.size() + " " + relationNoun).println();
}
