  "lead": {
    "en": "Express well-formedness rules in EVL with constraints, critiques, guards and fixes.",
    "zh": "用 EVL 表达良构性规则：约束、建议性检查（critique）、守卫条件与修复。"
  },
  "prerequisites": {
    "en": "Modules 1–4 are recommended. Examples run in the Playground unless noted.",
