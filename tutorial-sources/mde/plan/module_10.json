  "lead": {
    "en": "Build a JHipster-style entity language end to end: metamodel, models, validation, generation and transformation.",
    "zh": "端到端构建一个 JHipster 风格的实体语言：元模型、模型、验证、生成与转换。"
  },
  "prerequisites": {
    "en": "Modules 1–9 are recommended. Examples run in the Playground unless noted.",
